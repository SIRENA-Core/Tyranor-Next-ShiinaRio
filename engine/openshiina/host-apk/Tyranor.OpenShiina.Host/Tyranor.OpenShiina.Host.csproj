<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Tyranor.OpenShiina.Host</RootNamespace>
    <AssemblyName>Tyranor.OpenShiina.Host</AssemblyName>
    <ApplicationId>com.tyranor.next.shiinario</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>30</SupportedOSPlatformVersion>
    <UseMonoRuntime>false</UseMonoRuntime>
    <UseCurrentRuntimeIdentifier>false</UseCurrentRuntimeIdentifier>
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
    <RuntimeIdentifiers Condition="'$(HostRuntimeIdentifiers)' != ''">$(HostRuntimeIdentifiers)</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(HostRuntimeIdentifiers)' == '' and '$(RuntimeIdentifiers)' == ''">android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidManifest>Properties/AndroidManifest.xml</AndroidManifest>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <OpenShiinaSource Condition="'$(OpenShiinaSource)' == ''">$(OPENSHIINA_SOURCE)</OpenShiinaSource>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(OpenShiinaSource)' != '' and Exists('$(OpenShiinaSource)/src/OpenShiina.App/OpenShiina.App.csproj')">
    <ProjectReference Include="$(OpenShiinaSource)/src/OpenShiina.App/OpenShiina.App.csproj" />
    <ProjectReference Include="$(OpenShiinaSource)/src/OpenShiina.Core/OpenShiina.Core.csproj" />
    <ProjectReference Include="$(OpenShiinaSource)/src/OpenShiina.Gpu/OpenShiina.Gpu.csproj" />
    <AndroidAsset Include="$(OpenShiinaSource)/src/OpenShiina.Core/Data/Formats.Json" LogicalName="Formats.Json" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="$(MSBuildThisFileDirectory)../../games.json" LogicalName="tyn/games.json" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.UnfairSemaphoreSpinLimit" Value="0" />
  </ItemGroup>

  <Target Name="ValidateOpenShiinaSource" BeforeTargets="BeforeResolveReferences;PrepareForBuild">
    <Error Condition="'$(OpenShiinaSource)' == ''"
           Text="必须通过 -p:OpenShiinaSource=&lt;path&gt; 或 OPENSHIINA_SOURCE 指定已打补丁的 OpenShiina 源码目录。" />
    <Error Condition="!Exists('$(OpenShiinaSource)/src/OpenShiina.App/OpenShiina.App.csproj')"
           Text="OpenShiinaSource 目录无效，找不到：$(OpenShiinaSource)/src/OpenShiina.App/OpenShiina.App.csproj" />
  </Target>
</Project>
